<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Storage needs an application Context before any UI exists, so the initializer lives here
          rather than with the viewer. `:inspektor-ui` merges its own entries on top.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.gyanoba.inspektor.utils.ContextInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
